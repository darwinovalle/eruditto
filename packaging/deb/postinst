#!/bin/sh
# postinst — runs after dpkg installs eruditto
set -e

# (Re)build the icon cache so GNOME/other DEs discover the new icons.
# The PNGs are shipped in /usr/share/icons/hicolor/ — the system
# index.theme already declares these subdirs so no local override is
# needed.
if [ -x /usr/bin/gtk-update-icon-cache ]; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor/ 2>/dev/null || true
fi

# (Re)build the MIME/app cache so .desktop files are discovered.
if [ -x /usr/bin/update-desktop-database ]; then
    update-desktop-database /usr/share/applications/ 2>/dev/null || true
fi

# Register the .desktop file with the desktop menu.
if [ -x /usr/bin/xdg-desktop-menu ]; then
    xdg-desktop-menu forceupdate 2>/dev/null || true
fi

#DEBHELPER#
